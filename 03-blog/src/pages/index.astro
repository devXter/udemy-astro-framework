---
import { getCollection } from "astro:content";
import { siteConfig } from "../config/site-config";
import Layout from "../layouts/Layout.astro";
import TypedBlogPost from "src/components/TypedBlogPost.astro";

// Obtiene todos los posts de la carpeta posts (md, mdx) y los guarda en la variable posts. Astro.glob() estará deprecado en el futuro.
// const posts = await Astro.glob("./posts/*.{md,mdx}");

// Obtiene todos los posts de la carpeta posts (md, mdx) y los guarda en la variable postsNewWay. Recomendado por Astro.
// const postsNewWay = Object.values(import.meta.glob("./posts/*.{md,mdx}"));

const blogPosts = await getCollection("blog");
---

<Layout title="Francisco's Blog">
  <!-- component -->
  <section class="bg-white dark:bg-gray-900">
    <div class="container px-6 py-10 mx-auto">
      <h1
        class="text-3xl font-semibold text-gray-800 capitalize lg:text-4xl dark:text-white"
      >
        {siteConfig.title}
      </h1>

      <a href="/blog/1">Blog paginado</a>

      <div class="grid grid-cols-1 gap-8 mt-8 md:mt-16 md:grid-cols-2">
        {blogPosts.map((post) => <TypedBlogPost post={post} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  a {
    @apply text-blue-500 hover:underline;
  }
</style>
