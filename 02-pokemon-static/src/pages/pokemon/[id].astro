---
import type { GetStaticPaths } from "astro";
import Layout from "@layouts/Layout.astro";
import type { PokemonListResponse } from "@interfaces/pokemon-list.response";

// Path relativo
// import PokemonCard from "../../components/pokemons/PokemonCard.astro";

// Path absoluto
// import PokemonCard from "src/components/pokemons/PokemonCard.astro";

// Path alias
import PokemonCard from "@components/pokemons/PokemonCard.astro";



export const getStaticPaths = (async () => {
    const response = await fetch("https://pokeapi.co/api/v2/pokemon?limit=151");
    const { results } = (await response.json()) as PokemonListResponse;

    return results.map(({ name, url }) => ({
        params: { id: url.split("/").at(-2) ?? "" },
        props: { name, url },
    }));
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const { name, url } = Astro.props;
const audioSrc: string = `https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/${id}.ogg`;
---

<Layout title={name}>
    <section class="mt-10 mx-10 flex flex-col justify-center items-center">
        <div>
            <a href="/">Regresar</a>
            <h1 class="capitalize text-3xl">{name}</h1>
        </div>

        <PokemonCard name={name} url={url} isBig />
        <audio controls class="mt-10">
            <source src={audioSrc} type="audio/ogg" />
        </audio>
    </section>
</Layout>


<style>
    a {
        @apply hover:underline text-blue-500;
    }
</style>