---
interface Props {
    name: string;
    url: string;
    isBig?: boolean;
}

const { name, url, isBig = false } = Astro.props;
const id: string = url.split("/").at(-2) ?? "";

const imgSrc: string = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`;
---

<a
    href={`/pokemons/${name}`}
    class:list={[
        "rounded flex flex-col justify-center items-center p-2",
        {
            border: !isBig,
        },
    ]}
>
    <img
        transition:name={`${name}-img`}
        class:list={[
            {
                "w-22 h-22": !isBig,
                "w-26 h-26": isBig,
            },
        ]}
        src={imgSrc}
        alt={name}
    />
    <span
        class:list={[
            "capitalize",
            {
                "text-4xl text-blue-500": isBig,
            },
        ]}>#{id} {name}</span
    >
</a>
