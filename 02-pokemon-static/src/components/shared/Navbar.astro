---
const links = [
    {
        label: "Listado",
        href: "/",
    },
    {
        label: "Paginado",
        href: "/pokemons/1",
    },
    {
        label: "Favoritos",
        href: "/favorites",
    },
    {
        label: "Isla",
        href: "/island",
    },
];

const currentPath = Astro.url.pathname;
---

<!-- component -->
<nav class="shadow bg-slate-900">
    <div
        class="container flex items-center justify-center p-6 mx-auto text-white-600 capitalize dark:text-gray-300"
    >
        {
            links.map(({ label, href }) => (
                // Modo tradicional de hacer el condicional
                // <a
                //     href={href}
                //     class:list={[
                //         "text-slate-300 mx-1.5 sm:mx-6",
                //         {
                //             "border-b-2 border-blue-500": href === currentPath,
                //         },
                //     ]}
                // >
                //     {label}
                // </a>

                // Modo Astro
                <div>
                    <a href={href} class="text-slate-300 mx-1.5 sm:mx-6">
                        {label}
                    </a>

                    {currentPath === href ? (
                        <div
                            transition:name="menu-line"
                            class="border-b-2 border-blue-500 mx-4"
                        />
                    ) : (
                        <div class="border-b-2 border-transparent" />
                    )}
                </div>
            ))
        }
    </div>
</nav>
